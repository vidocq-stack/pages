' Vidocq site — global PlantUML skin
' Applied automatically to every diagram via quarkus.asciidoc.attributes.plantuml-include
' Uses the built-in sketchy-outline theme + Vidocq EU-blue palette overrides

!theme sketchy-outline

skinparam handwritten true
skinparam backgroundColor transparent
skinparam defaultTextAlignment center
skinparam defaultFontSize 13
skinparam defaultFontName "Gloria Hallelujah,Architects Daughter,Comic Sans MS,sans-serif"
skinparam padding 6

' EU Blue palette
skinparam ArrowColor #1d4ed8
skinparam ArrowFontColor #374151

skinparam SequenceGroupBorderColor #1e40af
skinparam SequenceGroupHeaderFontColor #1e40af

skinparam NoteBackgroundColor #eff6ff
skinparam NoteBorderColor #bfdbfe
skinparam NoteFontColor #1e3a8a

skinparam ActorBorderColor #1e40af
skinparam ActorBackgroundColor #dbeafe
skinparam ActorFontColor #1e3a8a

skinparam ComponentBorderColor #1e40af
skinparam ComponentBackgroundColor #eff6ff
skinparam ComponentFontColor #1e3a8a

skinparam PackageBorderColor #1e40af
skinparam PackageBackgroundColor #f0f4ff

skinparam ClassBorderColor #1e40af
skinparam ClassBackgroundColor #eff6ff
skinparam ClassHeaderBackgroundColor #dbeafe
skinparam ClassFontColor #1e3a8a

skinparam DatabaseBorderColor #1e40af
skinparam DatabaseBackgroundColor #eff6ff

skinparam QueueBorderColor #1e40af
skinparam QueueBackgroundColor #eff6ff
